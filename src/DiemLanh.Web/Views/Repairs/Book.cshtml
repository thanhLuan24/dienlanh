@model DiemLanh.Application.DTOs.Repair.RepairRequestCreateDto
@{
    ViewData["Title"] = "Đặt lịch Sửa chữa";
    var stores = ViewBag.Stores as IEnumerable<DiemLanh.Application.DTOs.Store.StoreListDto> ?? Enumerable.Empty<DiemLanh.Application.DTOs.Store.StoreListDto>();
    var selectedStoreId = ViewBag.SelectedStoreId as int? ?? 0;
}

<style>
    .book-repair-wrap { max-width: 820px; margin: 3rem auto; padding: 0 1rem; }
    .book-card { background: var(--white); border: 1px solid var(--grey-dark); border-radius: var(--radius-lg); padding: 2.5rem; box-shadow: 0 10px 30px rgba(0,0,0,.04); }
    .book-title { font-family: var(--font-display); font-size: 1.75rem; font-weight: 800; text-transform: uppercase; margin-bottom: .5rem; }
    .book-sub { color: var(--grey); margin-bottom: 2rem; }
    .step-header { font-family: var(--font-mono); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--neon); margin-bottom: 1rem; display: flex; align-items: center; gap: .5rem; }
    .form-group-custom { margin-bottom: 1.5rem; }
    .form-group-custom label { font-weight: 600; font-size: .9rem; margin-bottom: .4rem; display: block; color: var(--black); }
</style>

<div class="book-repair-wrap">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]</div>
    }

    <div class="book-card">
        <h2 class="book-title">Đặt Lịch Sửa Chữa Tận Nhà</h2>
        <p class="book-sub">Điền thông tin sự cố thiết bị điện lạnh để được kỹ thuật viên hỗ trợ nhanh nhất.</p>

        <form method="post" action="/repairs/book" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <!-- Step 1 -->
            <div class="step-header">
                <span style="background:var(--neon);color:#fff;width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem">1</span>
                Chọn Cửa Hàng & Thiết Bị
            </div>

            <div class="row g-3 form-group-custom">
                <div class="col-12">
                    <label>Cửa hàng phụ trách <span class="text-danger">*</span></label>
                    @{
                        var storeSelectHtml = "<select name='StoreId' class='form-select form-select-lg' required><option value=''>-- Chọn cửa hàng gần bạn --</option>";
                        foreach (var s in stores)
                        {
                            var loc = !string.IsNullOrEmpty(s.Province) ? $" ({s.Province})" : "";
                            storeSelectHtml += $"<option value='{s.Id}'{(s.Id == selectedStoreId || s.Id == Model.StoreId ? " selected" : "")}>{s.Name}{loc}</option>";
                        }
                        storeSelectHtml += "</select>";
                    }
                    @Html.Raw(storeSelectHtml)
                    @Html.ValidationMessageFor(m => m.StoreId, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    <label>Loại thiết bị <span class="text-danger">*</span></label>
                    <select name="DeviceType" class="form-select" required>
                        <option value="">-- Chọn loại máy --</option>
                        <option value="Điều hòa / Máy lạnh" selected="@(Model.DeviceType == "Điều hòa / Máy lạnh")">Điều hòa / Máy lạnh</option>
                        <option value="Tủ lạnh / Tủ đông" selected="@(Model.DeviceType == "Tủ lạnh / Tủ đông")">Tủ lạnh / Tủ đông</option>
                        <option value="Máy giặt / Máy sấy" selected="@(Model.DeviceType == "Máy giặt / Máy sấy")">Máy giặt / Máy sấy</option>
                        <option value="Bình nóng lạnh" selected="@(Model.DeviceType == "Bình nóng lạnh")">Bình nóng lạnh</option>
                        <option value="Khác" selected="@(Model.DeviceType == "Khác")">Thiết bị khác</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label>Hãng sản xuất / Thương hiệu <span class="text-danger">*</span></label>
                    <input type="text" name="Brand" value="@Model.Brand" class="form-control" placeholder="Daikin, Panasonic, LG, Samsung..." required />
                </div>
                <div class="col-12">
                    <label>Model máy (nếu có)</label>
                    <input type="text" name="Model" value="@Model.Model" class="form-control" placeholder="Mã model in trên máy (ví dụ: FTKF25XVMV)" />
                </div>
            </div>

            <!-- Step 2 -->
            <div class="step-header">
                <span style="background:var(--neon);color:#fff;width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem">2</span>
                Mô Tả Sự Cố & Triệu Chứng
            </div>

            <div class="form-group-custom">
                <label>Mô tả chi tiết lỗi / sự cố <span class="text-danger">*</span></label>
                <textarea name="Symptoms" class="form-control" rows="4" placeholder="Ví dụ: Máy lạnh mở lên 5 phút bị chớp đèn nháy lỗi, chảy nước dàn lạnh, không ra hơi lạnh..." required>@Model.Symptoms</textarea>
            </div>
            
            <div class="form-group-custom">
                <label>Hình ảnh sự cố (tối đa 3 ảnh)</label>
                <input type="file" name="Images" class="form-control" accept="image/*" multiple max="3" />
                <div class="form-text text-muted small mt-1">Cung cấp hình ảnh (mã lỗi trên màn hình, máy rò nước...) giúp kỹ thuật viên chuẩn bị linh kiện thay thế nhanh hơn.</div>
            </div>

            <!-- Step 3 -->
            <div class="step-header">
                <span style="background:var(--neon);color:#fff;width:24px;height:24px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem">3</span>
                Địa Chỉ & Liên Hệ
            </div>

            <div class="row g-3 form-group-custom">
                <div class="col-md-6">
                    <label>Họ và tên khách hàng <span class="text-danger">*</span></label>
                    <input type="text" name="CustomerName" value="@Model.CustomerName" class="form-control" placeholder="Nguyễn Văn A" required />
                </div>
                <div class="col-md-6">
                    <label>Số điện thoại liên hệ <span class="text-danger">*</span></label>
                    <input type="tel" name="CustomerPhone" value="@Model.CustomerPhone" class="form-control" placeholder="0901234567" required />
                </div>
                <div class="col-12">
                    <label>Địa chỉ kiểm tra tận nhà <span class="text-danger">*</span></label>
                    <input type="text" name="CustomerAddress" value="@Model.CustomerAddress" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" required />
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-3">
                <button type="submit" class="btn btn-neon btn-lg flex-grow-1" style="justify-content:center">
                    <i class="bi bi-calendar-check me-2"></i>Gửi Yêu Cầu Đặt Lịch
                </button>
                <a href="/" class="btn btn-outline btn-lg">Hủy</a>
            </div>
        </form>
    </div>
</div>
