@model DiemLanh.Application.DTOs.Admin.AdminOverviewDto
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["AdminTitle"] = "Dashboard Tổng quan";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<!-- KPI Cards -->
<div class="adm-kpi-grid">
    <div class="adm-kpi">
        <i class="bi bi-people adm-kpi-icon"></i>
        <div class="adm-kpi-label">Tổng người dùng</div>
        <div class="adm-kpi-value">@Model.TotalUsers.ToString("N0")</div>
        <div class="adm-kpi-sub">+@Model.NewUsersToday hôm nay</div>
    </div>
    <div class="adm-kpi">
        <i class="bi bi-shop adm-kpi-icon"></i>
        <div class="adm-kpi-label">Cửa hàng</div>
        <div class="adm-kpi-value">@Model.TotalStores.ToString("N0")</div>
        <div class="adm-kpi-sub" style="color:@(Model.PendingStores > 0 ? "#D97706" : "var(--grey-mid)")">
            @Model.PendingStores chờ duyệt
        </div>
    </div>
    <div class="adm-kpi">
        <i class="bi bi-box-seam adm-kpi-icon"></i>
        <div class="adm-kpi-label">Sản phẩm</div>
        <div class="adm-kpi-value">@Model.TotalProducts.ToString("N0")</div>
        <div class="adm-kpi-sub">Tổng trong hệ thống</div>
    </div>
    <div class="adm-kpi">
        <i class="bi bi-receipt adm-kpi-icon"></i>
        <div class="adm-kpi-label">Đơn hàng</div>
        <div class="adm-kpi-value">@Model.TotalOrders.ToString("N0")</div>
        <div class="adm-kpi-sub">+@Model.NewOrdersToday hôm nay</div>
    </div>
    <div class="adm-kpi" style="border-left:3px solid var(--neon)">
        <i class="bi bi-currency-dollar adm-kpi-icon"></i>
        <div class="adm-kpi-label">Tổng doanh thu</div>
        <div class="adm-kpi-value" style="font-size:1.3rem">@Model.TotalRevenue.ToString("N0")đ</div>
        <div class="adm-kpi-sub">Đơn hoàn thành</div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1.5rem">
    <!-- Top Viewed Products -->
    <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
            <span style="font-weight:700;color:var(--black)">
                <i class="bi bi-eye me-1" style="color:var(--neon)"></i>Sản phẩm lượt xem cao nhất
            </span>
            <a href="/admin/products" class="btn-adm btn-adm-outline btn-adm-sm">Xem tất cả</a>
        </div>
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead><tr><th>Sản phẩm</th><th>Lượt xem</th><th>Đã bán</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.TopViewedProducts)
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="" class="adm-img-thumb"/>
                                    }
                                    else
                                    {
                                        <div class="adm-img-thumb" style="display:flex;align-items:center;justify-content:center;color:var(--grey-mid)"><i class="bi bi-image"></i></div>
                                    }
                                    <div>
                                        <div style="font-weight:600;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@p.Name</div>
                                        <div style="font-size:.72rem;color:var(--grey-mid)">@p.Brand · @p.CategoryName</div>
                                    </div>
                                </div>
                            </td>
                            <td><span style="color:var(--neon);font-weight:700">@p.ViewCount.ToString("N0")</span></td>
                            <td><span style="color:var(--grey)">@p.SoldCount.ToString("N0")</span></td>
                        </tr>
                    }
                    @if (!Model.TopViewedProducts.Any())
                    {
                        <tr><td colspan="3" style="text-align:center;color:var(--grey-mid);padding:2rem">Chưa có dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Top Sold Products -->
    <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
            <span style="font-weight:700;color:var(--black)">
                <i class="bi bi-fire me-1" style="color:#E11D48"></i>Sản phẩm bán chạy nhất
            </span>
            <a href="/admin/products?SortBy=best_seller" class="btn-adm btn-adm-outline btn-adm-sm">Xem tất cả</a>
        </div>
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead><tr><th>Sản phẩm</th><th>Đã bán</th><th>Giá</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.TopSoldProducts)
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px">
                                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="" class="adm-img-thumb"/>
                                    }
                                    else
                                    {
                                        <div class="adm-img-thumb" style="display:flex;align-items:center;justify-content:center;color:var(--grey-mid)"><i class="bi bi-image"></i></div>
                                    }
                                    <div>
                                        <div style="font-weight:600;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@p.Name</div>
                                        <div style="font-size:.72rem;color:var(--grey-mid)">@p.Brand · @p.CategoryName</div>
                                    </div>
                                </div>
                            </td>
                            <td><span style="color:#E11D48;font-weight:700">@p.SoldCount.ToString("N0")</span></td>
                            <td><span style="color:var(--grey);font-size:.8rem">@p.Price.ToString("N0")đ</span></td>
                        </tr>
                    }
                    @if (!Model.TopSoldProducts.Any())
                    {
                        <tr><td colspan="3" style="text-align:center;color:var(--grey-mid);padding:2rem">Chưa có dữ liệu</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Recent Users -->
<div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem">
        <span style="font-weight:700;color:var(--black)">
            <i class="bi bi-person-plus me-1" style="color:var(--neon)"></i>Người dùng mới nhất
        </span>
        <a href="/admin/users" class="btn-adm btn-adm-outline btn-adm-sm">Quản lý người dùng</a>
    </div>
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead><tr><th>Người dùng</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tham gia</th></tr></thead>
            <tbody>
                @foreach (var u in Model.RecentUsers)
                {
                    <tr>
                        <td>
                            <div>
                                <div style="font-weight:600">@u.FullName</div>
                                <div style="font-size:.75rem;color:var(--grey-mid)">@u.Email</div>
                            </div>
                        </td>
                        <td>
                            <span class="badge-pill @(u.Role == "SuperAdmin" ? "badge-danger" : u.Role == "StoreOwner" ? "badge-info" : "badge-grey")">
                                @u.Role
                            </span>
                        </td>
                        <td>
                            <span class="badge-pill @(u.IsActive ? "badge-success" : "badge-danger")">
                                @(u.IsActive ? "Hoạt động" : "Đã khóa")
                            </span>
                        </td>
                        <td style="font-size:.8rem;color:var(--grey-mid)">@u.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
