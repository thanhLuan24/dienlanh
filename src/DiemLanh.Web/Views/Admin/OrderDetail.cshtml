@model DiemLanh.Application.DTOs.Order.OrderDto
@{
    ViewData["Title"] = $"Đơn hàng #{Model.OrderCode}";
    ViewData["AdminTitle"] = $"Đơn hàng #{Model.OrderCode}";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

@{
    var bClass = Model.Status switch
    {
        DiemLanh.Domain.Enums.OrderStatus.PendingConfirmation => "badge-warning",
        DiemLanh.Domain.Enums.OrderStatus.Confirmed or DiemLanh.Domain.Enums.OrderStatus.Preparing or DiemLanh.Domain.Enums.OrderStatus.Shipping => "badge-info",
        DiemLanh.Domain.Enums.OrderStatus.Completed or DiemLanh.Domain.Enums.OrderStatus.Installed or DiemLanh.Domain.Enums.OrderStatus.Delivered => "badge-success",
        DiemLanh.Domain.Enums.OrderStatus.Cancelled or DiemLanh.Domain.Enums.OrderStatus.Rejected => "badge-danger",
        _ => "badge-grey"
    };
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem">
    <div>
        <a href="/admin/orders" style="display:inline-flex;align-items:center;gap:.4rem;color:var(--grey-mid);text-decoration:none;font-size:.8rem;margin-bottom:.5rem">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
        <div style="display:flex;align-items:center;gap:.75rem">
            <h2 style="font-size:1.4rem;font-weight:800;letter-spacing:-.02em;margin:0">#@Model.OrderCode</h2>
            <span class="badge-pill @bClass">@Model.StatusDisplay</span>
        </div>
        <div style="font-size:.8rem;color:var(--grey-mid);margin-top:.25rem">Đặt lúc @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
    </div>

    <!-- Quick Actions -->
    @if (Model.Status == DiemLanh.Domain.Enums.OrderStatus.PendingConfirmation)
    {
        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NewStatus" value="1" />
                <button type="submit" class="btn-adm btn-adm-primary">
                    <i class="bi bi-check2-circle"></i> Xác nhận đơn
                </button>
            </form>
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NewStatus" value="8" />
                <button type="submit" class="btn-adm btn-adm-danger" onclick="return confirm('Từ chối đơn hàng này?')">
                    <i class="bi bi-x-circle"></i> Từ chối
                </button>
            </form>
        </div>
    }
    else if (Model.Status == DiemLanh.Domain.Enums.OrderStatus.Confirmed || Model.Status == DiemLanh.Domain.Enums.OrderStatus.Preparing)
    {
        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NewStatus" value="3" />
                <button type="submit" class="btn-adm btn-adm-primary"><i class="bi bi-truck"></i> Chuyển sang Giao hàng</button>
            </form>
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NewStatus" value="7" />
                <button type="submit" class="btn-adm btn-adm-danger" onclick="return confirm('Hủy đơn hàng này?')">
                    <i class="bi bi-trash"></i> Hủy đơn
                </button>
            </form>
        </div>
    }
</div>

<div style="display:grid;grid-template-columns:1fr 340px;gap:1.5rem;align-items:start">
    <!-- Left column -->
    <div>
        <!-- Items -->
        <div class="adm-form-section" style="margin-bottom:1.5rem">
            <div class="adm-form-section-title"><i class="bi bi-box-seam me-1"></i>Sản phẩm đặt mua</div>
            @foreach (var item in Model.Items)
            {
                <div style="display:flex;gap:1rem;align-items:center;padding:.75rem 0;border-bottom:1px solid var(--grey-dark)">
                    @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                    {
                        <img src="@item.ProductImageUrl" alt="@item.ProductName" style="width:60px;height:60px;object-fit:contain;border-radius:8px;background:var(--charcoal);border:1px solid var(--grey-dark)" />
                    }
                    else
                    {
                        <div style="width:60px;height:60px;border-radius:8px;background:var(--charcoal);border:1px solid var(--grey-dark);display:flex;align-items:center;justify-content:center;color:var(--grey-mid)">
                            <i class="bi bi-wind"></i>
                        </div>
                    }
                    <div style="flex:1">
                        <div style="font-weight:600;margin-bottom:.2rem">@item.ProductName</div>
                        @if (item.WarrantyMonths.HasValue)
                        {
                            <div style="font-size:.75rem;color:var(--grey-mid)">Bảo hành @item.WarrantyMonths tháng</div>
                        }
                    </div>
                    <div style="text-align:right">
                        <div style="font-size:.85rem;color:var(--grey-mid)">@item.UnitPrice.ToString("N0")đ × @item.Quantity</div>
                        <div style="font-weight:700;color:var(--neon)">@item.TotalPrice.ToString("N0")đ</div>
                    </div>
                </div>
            }
            <div style="display:flex;justify-content:flex-end;padding-top:.75rem">
                <div style="text-align:right">
                    <div style="font-size:.8rem;color:var(--grey-mid)">Tổng cộng</div>
                    <div style="font-size:1.4rem;font-weight:800;color:var(--neon)">@Model.TotalAmount.ToString("N0")đ</div>
                </div>
            </div>
        </div>

        <!-- Notes -->
        @if (!string.IsNullOrEmpty(Model.Note) || !string.IsNullOrEmpty(Model.StoreNote))
        {
            <div class="adm-form-section">
                <div class="adm-form-section-title"><i class="bi bi-chat-text me-1"></i>Ghi chú</div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div style="margin-bottom:.75rem">
                        <div style="font-size:.7rem;color:var(--grey-mid);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.3rem">Ghi chú của khách hàng</div>
                        <div style="background:var(--charcoal);border-radius:6px;padding:.75rem 1rem;font-size:.875rem">@Model.Note</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.StoreNote))
                {
                    <div>
                        <div style="font-size:.7rem;color:var(--grey-mid);text-transform:uppercase;letter-spacing:.08em;margin-bottom:.3rem">Ghi chú của cửa hàng</div>
                        <div style="background:rgba(13,148,136,.05);border:1px solid rgba(13,148,136,.15);border-radius:6px;padding:.75rem 1rem;font-size:.875rem">@Model.StoreNote</div>
                    </div>
                }
            </div>
        }

        <!-- Update Status Form -->
        <div class="adm-form-section">
            <div class="adm-form-section-title"><i class="bi bi-arrow-repeat me-1"></i>Cập nhật trạng thái</div>
            <form asp-action="UpdateOrderStatus" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="adm-input-2col" style="margin-bottom:1rem">
                    <div class="adm-field">
                        <label class="adm-label">Trạng thái mới</label>
                        <select name="NewStatus" class="adm-input">
                            <option value="0" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.PendingConfirmation)">Chờ xác nhận</option>
                            <option value="1" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Confirmed)">Đã xác nhận</option>
                            <option value="2" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Preparing)">Đang chuẩn bị</option>
                            <option value="3" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Shipping)">Đang giao</option>
                            <option value="4" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Delivered)">Đã giao</option>
                            <option value="5" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Installed)">Đã lắp đặt</option>
                            <option value="6" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Completed)">Hoàn thành</option>
                            <option value="7" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Cancelled)">Đã hủy</option>
                            <option value="8" selected="@(Model.Status == DiemLanh.Domain.Enums.OrderStatus.Rejected)">Từ chối</option>
                        </select>
                    </div>
                    <div class="adm-field">
                        <label class="adm-label">Ghi chú (tùy chọn)</label>
                        <input type="text" name="Note" class="adm-input" placeholder="Lý do, thông tin thêm..." />
                    </div>
                </div>
                <button type="submit" class="btn-adm btn-adm-primary">
                    <i class="bi bi-check2"></i> Cập nhật trạng thái
                </button>
            </form>
        </div>
    </div>

    <!-- Right column -->
    <div>
        <!-- Customer info -->
        <div class="adm-form-section" style="margin-bottom:1.5rem">
            <div class="adm-form-section-title"><i class="bi bi-person me-1"></i>Thông tin khách hàng</div>
            <div style="display:flex;flex-direction:column;gap:.6rem;font-size:.875rem">
                <div style="display:flex;gap:.5rem;align-items:start">
                    <i class="bi bi-person" style="color:var(--neon);width:16px;flex-shrink:0;margin-top:.1rem"></i>
                    <span>@Model.CustomerName</span>
                </div>
                <div style="display:flex;gap:.5rem;align-items:start">
                    <i class="bi bi-telephone" style="color:var(--neon);width:16px;flex-shrink:0;margin-top:.1rem"></i>
                    <span>@Model.CustomerPhone</span>
                </div>
                <div style="display:flex;gap:.5rem;align-items:start">
                    <i class="bi bi-envelope" style="color:var(--neon);width:16px;flex-shrink:0;margin-top:.1rem"></i>
                    <span>@Model.CustomerEmail</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                {
                    <div style="display:flex;gap:.5rem;align-items:start">
                        <i class="bi bi-geo-alt" style="color:var(--neon);width:16px;flex-shrink:0;margin-top:.1rem"></i>
                        <span>@Model.ShippingAddress</span>
                    </div>
                }
            </div>
        </div>

        <!-- Store info -->
        <div class="adm-form-section" style="margin-bottom:1.5rem">
            <div class="adm-form-section-title"><i class="bi bi-shop me-1"></i>Cửa hàng xử lý</div>
            <div style="font-weight:600;margin-bottom:.25rem">@Model.StoreName</div>
            <a href="/admin/stores" class="btn-adm btn-adm-outline btn-adm-sm">
                <i class="bi bi-arrow-up-right-square"></i> Xem cửa hàng
            </a>
        </div>

        <!-- Timeline -->
        <div class="adm-form-section">
            <div class="adm-form-section-title"><i class="bi bi-clock-history me-1"></i>Lịch sử</div>
            <div style="font-size:.8rem;display:flex;flex-direction:column;gap:.5rem">
                <div style="display:flex;gap:.5rem;align-items:start">
                    <i class="bi bi-circle-fill" style="color:var(--neon);font-size:.4rem;margin-top:.4rem;flex-shrink:0"></i>
                    <div>
                        <div style="font-weight:600">Đơn hàng được tạo</div>
                        <div style="color:var(--grey-mid)">@Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
                @if (Model.ConfirmedAt.HasValue)
                {
                    <div style="display:flex;gap:.5rem;align-items:start">
                        <i class="bi bi-circle-fill" style="color:#10b981;font-size:.4rem;margin-top:.4rem;flex-shrink:0"></i>
                        <div>
                            <div style="font-weight:600">Đã xác nhận</div>
                            <div style="color:var(--grey-mid)">@Model.ConfirmedAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
