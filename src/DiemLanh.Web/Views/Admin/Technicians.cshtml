@model IEnumerable<TechnicianDto>
@{
    ViewData["Title"] = "Quản lý Kỹ thuật viên";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var stores = ViewBag.Stores as IEnumerable<DiemLanh.Application.DTOs.Admin.StoreSimpleDto> ?? Enumerable.Empty<DiemLanh.Application.DTOs.Admin.StoreSimpleDto>();
    var selectedStoreId = ViewBag.SelectedStoreId as int?;
}

<form method="get" action="/admin/technicians" class="adm-filter-bar">
    <select name="storeId" onchange="this.form.submit()" style="background:var(--charcoal);border:1px solid var(--grey-dark);color:var(--black);padding:8px 12px;border-radius:6px;font-size:.85rem;outline:none;min-width:240px">
        <option value="">-- Tất cả cửa hàng --</option>
        @foreach (var s in stores)
        {
            <option value="@s.Id" selected="@(selectedStoreId == s.Id)">@s.Name</option>
        }
    </select>
    <a href="/admin/technicians" class="btn-adm btn-adm-outline">Xóa bộ lọc</a>
</form>

<div style="display:grid;grid-template-columns:1fr 340px;gap:1.5rem">
    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr><th>Họ tên</th><th>Cửa hàng</th><th>Số điện thoại</th><th>Email</th><th>Chuyên môn</th><th>Hành động</th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td style="font-weight:600">@t.Name</td>
                        <td style="color:var(--neon);font-weight:600">@t.StoreName</td>
                        <td>@t.Phone</td>
                        <td style="font-size:.8rem;color:var(--grey-mid)">@t.Email</td>
                        <td><span class="badge-pill badge-grey">@t.Specialty</span></td>
                        <td>
                            <form method="post" action="/admin/technicians/@t.Id/delete" onsubmit="return confirm('Xóa KTV này?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-adm btn-adm-sm btn-adm-danger"><i class="bi bi-trash"></i> Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center;color:var(--grey-mid);padding:3rem">Chưa có kỹ thuật viên nào</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Add Technician Form -->
    <form method="post" action="/admin/technicians/add" class="adm-form-section">
        @Html.AntiForgeryToken()
        <div class="adm-form-section-title">THÊM KỸ THUẬT VIÊN MỚI</div>
        <div class="adm-field">
            <label class="adm-label">Thuộc Cửa Hàng *</label>
            <select name="StoreId" class="adm-input" required>
                <option value="">-- Chọn cửa hàng --</option>
                @foreach (var s in stores)
                {
                    <option value="@s.Id" selected="@(selectedStoreId == s.Id)">@s.Name</option>
                }
            </select>
        </div>
        <div class="adm-field">
            <label class="adm-label">Họ và tên *</label>
            <input type="text" name="Name" class="adm-input" required placeholder="Nguyễn Văn A" />
        </div>
        <div class="adm-field">
            <label class="adm-label">Số điện thoại</label>
            <input type="tel" name="Phone" class="adm-input" placeholder="0901234567" />
        </div>
        <div class="adm-field">
            <label class="adm-label">Email</label>
            <input type="email" name="Email" class="adm-input" placeholder="ktv@gmail.com" />
        </div>
        <div class="adm-field">
            <label class="adm-label">Chuyên môn</label>
            <input type="text" name="Specialty" class="adm-input" placeholder="Sửa máy lạnh, Tủ lạnh..." />
        </div>
        <button type="submit" class="btn-adm btn-adm-primary w-100" style="margin-top:1rem"><i class="bi bi-plus-lg"></i> Thêm KTV</button>
    </form>
</div>
