@model DiemLanh.Application.Common.PagedResult<DiemLanh.Application.DTOs.Admin.AdminProductListDto>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    ViewData["AdminTitle"] = "Sản phẩm toàn hệ thống";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<DiemLanh.Application.DTOs.Product.ProductCategoryDto> ?? Enumerable.Empty<DiemLanh.Application.DTOs.Product.ProductCategoryDto>();
    var brands = ViewBag.Brands as IEnumerable<DiemLanh.Application.Interfaces.ProductBrandDto> ?? Enumerable.Empty<DiemLanh.Application.Interfaces.ProductBrandDto>();
}

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem">
    <div style="font-family:var(--font-mono);font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--grey-mid)">
        Hiển thị @Model.Items.Count / @Model.TotalCount sản phẩm
    </div>
    <a href="/admin/products/create" class="btn-adm btn-adm-primary">
        <i class="bi bi-plus-lg"></i> Thêm sản phẩm
    </a>
</div>

<!-- Filter Bar -->
<form method="get" action="/admin/products" class="adm-filter-bar">
    <div class="adm-search">
        <i class="bi bi-search"></i>
        <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tên, SKU, thương hiệu..."/>
    </div>
    <select name="categoryId" onchange="this.form.submit()" style="background:var(--charcoal);border:1px solid var(--grey-dark);color:var(--black);padding:8px 12px;border-radius:6px;font-size:.85rem;outline:none">
        <option value="">-- Danh mục --</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id" selected="@(ViewBag.CategoryId?.ToString() == c.Id.ToString())">@c.Name</option>
        }
    </select>
    <select name="brandId" onchange="this.form.submit()" style="background:var(--charcoal);border:1px solid var(--grey-dark);color:var(--black);padding:8px 12px;border-radius:6px;font-size:.85rem;outline:none">
        <option value="">-- Thương hiệu --</option>
        @foreach (var b in brands)
        {
            <option value="@b.Id" selected="@(ViewBag.BrandId?.ToString() == b.Id.ToString())">@b.Name</option>
        }
    </select>
    <button type="submit" class="btn-adm btn-adm-primary"><i class="bi bi-search"></i> Tìm</button>
    <a href="/admin/products" class="btn-adm btn-adm-outline">Xóa bộ lọc</a>
</form>

<div class="adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Danh mục / Cửa hàng</th>
                <th>Giá</th>
                <th>Kho</th>
                <th>Lượt xem</th>
                <th>Đã bán</th>
                <th>Trạng thái</th>
                <th style="text-align:right">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td>
                        <div style="display:flex;align-items:center;gap:10px">
                            @if (!string.IsNullOrEmpty(p.MainImageUrl))
                            {
                                <img src="@p.MainImageUrl" alt="" class="adm-img-thumb"/>
                            }
                            else
                            {
                                <div class="adm-img-thumb" style="display:flex;align-items:center;justify-content:center;color:var(--grey-mid)"><i class="bi bi-image"></i></div>
                            }
                            <div>
                                <div style="font-weight:600;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@p.Name</div>
                                <div style="font-size:.7rem;color:var(--grey-mid);font-family:var(--font-mono)">@p.Brand · @p.Sku</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div style="font-size:.82rem">@p.CategoryName</div>
                        <div style="font-size:.72rem;color:var(--grey-mid)"><i class="bi bi-shop me-1"></i>@p.StoreName</div>
                    </td>
                    <td>
                        <div style="font-weight:700;color:var(--neon)">@((p.SalePrice ?? p.Price).ToString("N0"))đ</div>
                        @if (p.SalePrice.HasValue && p.SalePrice < p.Price)
                        {
                            <div style="font-size:.72rem;text-decoration:line-through;color:var(--grey-mid)">@p.Price.ToString("N0")đ</div>
                        }
                    </td>
                    <td>
                        <span style="color:@(p.Stock<=5?"#E11D48":p.Stock<=20?"#D97706":"var(--black)");font-weight:600">@p.Stock</span>
                    </td>
                    <td style="color:var(--neon);font-weight:600">@p.ViewCount.ToString("N0")</td>
                    <td style="color:#E11D48;font-weight:600">@p.SoldCount.ToString("N0")</td>
                    <td>
                        <span class="badge-pill @(p.Status=="Đang bán"?"badge-success":p.Status=="Ẩn"?"badge-warning":"badge-danger")">
                            @p.Status
                        </span>
                        @if (p.IsFeatured)
                        {
                            <span class="badge-pill badge-warning" style="margin-top:2px">HOT</span>
                        }
                    </td>
                    <td>
                        <div style="display:flex;gap:6px;justify-content:flex-end">
                            <a href="/products/@p.Slug" target="_blank" class="btn-adm btn-adm-sm btn-adm-outline" title="Xem trang public">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                            <a href="/admin/products/@p.Id/edit" class="btn-adm btn-adm-sm btn-adm-outline">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                            <form method="post" action="/admin/products/@p.Id/delete" style="margin:0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-adm btn-adm-sm btn-adm-danger"
                                        onclick="return confirm('Xóa vĩnh viễn sản phẩm \"@p.Name\"?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" style="text-align:center;color:var(--grey-mid);padding:3rem">
                    <i class="bi bi-box-seam" style="font-size:2rem;display:block;margin-bottom:.5rem"></i>
                    Không tìm thấy sản phẩm nào
                </td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="adm-pagination">
        @if (Model.HasPreviousPage)
        {
            <a href="/admin/products?page=@(Model.Page-1)&keyword=@ViewBag.Keyword"><i class="bi bi-chevron-left"></i></a>
        }
        @for (int i = Math.Max(1, Model.Page - 2); i <= Math.Min(Model.TotalPages, Model.Page + 2); i++)
        {
            <a href="/admin/products?page=@i&keyword=@ViewBag.Keyword" class="@(i==Model.Page?"active":"")">@i</a>
        }
        @if (Model.HasNextPage)
        {
            <a href="/admin/products?page=@(Model.Page+1)&keyword=@ViewBag.Keyword"><i class="bi bi-chevron-right"></i></a>
        }
    </div>
}
