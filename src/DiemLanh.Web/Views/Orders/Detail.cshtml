@model DiemLanh.Application.DTOs.Order.OrderDto
@{
    ViewData["Title"] = $"Đơn hàng #{Model.OrderCode}";
    ViewData["ActivePage"] = "Orders";
    Layout = "_StoreLayout";
}

@{
    var statusClass = Model.Status switch
    {
        DiemLanh.Domain.Enums.OrderStatus.PendingConfirmation => "warning",
        DiemLanh.Domain.Enums.OrderStatus.Confirmed => "info",
        DiemLanh.Domain.Enums.OrderStatus.Preparing => "primary",
        DiemLanh.Domain.Enums.OrderStatus.Shipping => "primary",
        DiemLanh.Domain.Enums.OrderStatus.Completed or DiemLanh.Domain.Enums.OrderStatus.Installed or DiemLanh.Domain.Enums.OrderStatus.Delivered => "success",
        DiemLanh.Domain.Enums.OrderStatus.Cancelled or DiemLanh.Domain.Enums.OrderStatus.Rejected => "danger",
        _ => "secondary"
    };
}

<div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
    <a href="/manage/orders/index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Quay lại
    </a>
    <div>
        <h4 class="mb-0 fw-bold">#@Model.OrderCode</h4>
        <small class="text-muted">@Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small>
    </div>
    <span class="badge bg-@statusClass-subtle text-@statusClass fs-6">@Model.StatusDisplay</span>

    <!-- Quick Actions for Pending -->
    @if (Model.Status == DiemLanh.Domain.Enums.OrderStatus.PendingConfirmation)
    {
        <div class="ms-auto d-flex gap-2">
            <form action="/manage/orders/update-status" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrderId" value="@Model.Id" />
                <input type="hidden" name="NewStatus" value="1" />
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-check2-circle me-1"></i>Chấp nhận đơn
                </button>
            </form>
            <form action="/manage/orders/update-status" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrderId" value="@Model.Id" />
                <input type="hidden" name="NewStatus" value="8" />
                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Từ chối đơn hàng này?')">
                    <i class="bi bi-x-circle me-1"></i>Từ chối
                </button>
            </form>
        </div>
    }
</div>

<div class="row g-4">
    <!-- Left column: items + actions -->
    <div class="col-lg-8">
        <!-- Items -->
        <div class="card mb-4">
            <div class="card-header fw-semibold"><i class="bi bi-box-seam me-2 text-primary"></i>Sản phẩm đặt mua</div>
            <div class="card-body p-0">
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                        {
                            <img src="@item.ProductImageUrl" alt="@item.ProductName" style="width:56px;height:56px;object-fit:contain;border-radius:8px;background:var(--bs-gray-100)" />
                        }
                        else
                        {
                            <div style="width:56px;height:56px;border-radius:8px;background:var(--bs-gray-200);display:flex;align-items:center;justify-content:center;color:#aaa">
                                <i class="bi bi-wind"></i>
                            </div>
                        }
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@item.ProductName</div>
                            @if (item.WarrantyMonths.HasValue)
                            {
                                <small class="text-muted">Bảo hành @item.WarrantyMonths tháng</small>
                            }
                        </div>
                        <div class="text-end">
                            <div class="text-muted small">@item.UnitPrice.ToString("N0")đ × @item.Quantity</div>
                            <div class="fw-bold text-primary">@item.TotalPrice.ToString("N0")đ</div>
                        </div>
                    </div>
                }
                <div class="d-flex justify-content-end p-3">
                    <div class="text-end">
                        <div class="text-muted small">Tổng cộng</div>
                        <div class="fs-4 fw-bold text-success">@Model.TotalAmount.ToString("N0")đ</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Update Status -->
        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-arrow-repeat me-2 text-primary"></i>Cập nhật trạng thái</div>
            <div class="card-body">
                <form action="/manage/orders/update-status" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrderId" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Trạng thái mới</label>
                            @{
                                var statusSelectHtml = "<select name='NewStatus' class='form-select'>";
                                var storeStatusOpts = new[] {
                                    (1, "✅ Đã xác nhận"), (2, "📦 Đang chuẩn bị"), (3, "🚚 Đang giao"),
                                    (4, "✔ Đã giao"), (5, "🔧 Đã lắp đặt"), (6, "🎉 Hoàn thành"), (7, "❌ Hủy đơn")
                                };
                                foreach (var (v, l) in storeStatusOpts)
                                    statusSelectHtml += $"<option value='{v}'{((int)Model.Status == v ? " selected" : "")}>{l}</option>";
                                statusSelectHtml += "</select>";
                            }
                            @Html.Raw(statusSelectHtml)
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold small">Ghi chú</label>
                            <input type="text" name="Note" class="form-control" placeholder="Ghi chú cho khách hàng..." value="@Model.StoreNote" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">Cập nhật</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right column: customer + delivery info -->
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header fw-semibold"><i class="bi bi-person me-2 text-primary"></i>Khách hàng</div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2 small">
                    <div><i class="bi bi-person text-primary me-2"></i><strong>@Model.CustomerName</strong></div>
                    <div><i class="bi bi-telephone text-primary me-2"></i>@Model.CustomerPhone</div>
                    <div><i class="bi bi-envelope text-primary me-2"></i>@Model.CustomerEmail</div>
                    @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                    {
                        <div><i class="bi bi-geo-alt text-primary me-2"></i>@Model.ShippingAddress</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <hr class="my-2" />
                        <div class="text-muted fst-italic">💬 "@Model.Note"</div>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-clock-history me-2 text-primary"></i>Lịch sử</div>
            <div class="card-body small">
                <div class="d-flex gap-2 mb-2">
                    <i class="bi bi-circle-fill text-primary" style="font-size:.4rem;margin-top:.4rem;flex-shrink:0"></i>
                    <div>
                        <div class="fw-semibold">Đơn hàng được tạo</div>
                        <div class="text-muted">@Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
                @if (Model.ConfirmedAt.HasValue)
                {
                    <div class="d-flex gap-2">
                        <i class="bi bi-circle-fill text-success" style="font-size:.4rem;margin-top:.4rem;flex-shrink:0"></i>
                        <div>
                            <div class="fw-semibold">Đã xác nhận</div>
                            <div class="text-muted">@Model.ConfirmedAt.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
