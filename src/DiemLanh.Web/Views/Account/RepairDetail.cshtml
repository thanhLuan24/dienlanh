@model DiemLanh.Application.DTOs.Repair.RepairRequestDto
@using DiemLanh.Domain.Enums
@{
    ViewData["Title"] = $"Yêu cầu sửa chữa #{Model.Id}";

    var step = Model.Status switch {
        RepairStatus.PendingReceive or RepairStatus.Checking => 1,
        RepairStatus.Scheduled or RepairStatus.Repairing => 2,
        RepairStatus.Completed => 3,
        _ => 0
    };

    var (statusClass, statusText) = Model.Status switch {
        RepairStatus.PendingReceive or RepairStatus.Checking => ("s-step1", "1. Tiếp nhận & Báo giá"),
        RepairStatus.Scheduled or RepairStatus.Repairing => ("s-step2", "2. Đang xử lý sửa chữa"),
        RepairStatus.Completed => ("s-step3", "3. Hoàn thành & Bảo hành"),
        RepairStatus.CannotRepair => ("s-closed", "Không thể sửa"),
        _ => ("s-closed", "Đã hủy")
    };
}

<style>
    .detail-wrap { max-width: 900px; margin: 2.5rem auto; padding: 0 1rem; }
    .detail-card { background: var(--white); border: 1px solid var(--grey-dark); border-radius: var(--radius-lg); padding: 2rem; margin-bottom: 1.5rem; }
    .status-badge-step { display: inline-flex; align-items: center; gap: .4rem; padding: 4px 14px; border-radius: 100px; font-family: var(--font-mono); font-size: .75rem; font-weight: 700; text-transform: uppercase; }
    .s-step1 { background: #FEF3C7; color: #92400E; border: 1px solid #FCD34D; }
    .s-step2 { background: #DBEAFE; color: #1E40AF; border: 1px solid #93C5FD; }
    .s-step3 { background: #D1FAE5; color: #065F46; border: 1px solid #6EE7B7; }
    .s-closed { background: #FEE2E2; color: #991B1B; border: 1px solid #FCA5A5; }

    /* Progress Tracker */
    .progress-tracker-large { display: flex; align-items: center; margin: 2rem 0; position: relative; }
    .tracker-step { flex: 1; text-align: center; position: relative; z-index: 1; }
    .tracker-circle { width: 44px; height: 44px; border-radius: 50%; background: var(--charcoal); border: 2px solid var(--grey-dark); color: var(--grey-mid); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; font-weight: 800; margin: 0 auto .5rem; transition: all .2s; }
    .tracker-label { font-size: .85rem; font-weight: 600; color: var(--grey-mid); }
    .tracker-sub { font-size: .75rem; color: var(--grey); margin-top: 2px; }
    .tracker-step.active .tracker-circle { background: var(--neon); border-color: var(--neon); color: #fff; box-shadow: 0 0 16px rgba(13,148,136,.3); }
    .tracker-step.active .tracker-label { color: var(--black); font-weight: 700; }
    .tracker-step.completed .tracker-circle { background: #10B981; border-color: #10B981; color: #fff; }
    .tracker-line { position: absolute; top: 22px; left: 16%; right: 16%; height: 3px; background: var(--grey-dark); z-index: 0; }
</style>

<div class="detail-wrap">
    <div class="mb-3">
        <a href="/auth/repairs" class="btn btn-outline btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
    </div>

    <!-- Header Card -->
    <div class="detail-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div>
                <span style="font-family:var(--font-mono);font-size:.85rem;color:var(--grey-mid)">Phiếu sửa chữa </span>
                <h3 style="font-family:var(--font-mono);font-weight:800;margin:0;display:inline-block;color:var(--neon)">#SR-@Model.Id</h3>
                <div style="font-size:.85rem;color:var(--grey);margin-top:4px">
                    Gửi lúc @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy") tại <strong>@Model.StoreName</strong>
                </div>
            </div>
            <span class="status-badge-step @statusClass">@statusText</span>
        </div>

        <!-- 3-Step Progress Bar (Option 1) -->
        @if (step > 0)
        {
            <div class="progress-tracker-large">
                <div class="tracker-line"></div>
                <div class="tracker-step @(step >= 1 ? (step > 1 ? "completed" : "active") : "")">
                    <div class="tracker-circle">@(step > 1 ? "✓" : "1")</div>
                    <div class="tracker-label">1. Tiếp nhận & Báo giá</div>
                    <div class="tracker-sub">Cửa hàng tiếp nhận & kiểm tra</div>
                </div>
                <div class="tracker-step @(step >= 2 ? (step > 2 ? "completed" : "active") : "")">
                    <div class="tracker-circle">@(step > 2 ? "✓" : "2")</div>
                    <div class="tracker-label">2. Đang xử lý sửa chữa</div>
                    <div class="tracker-sub">KTV đến tận nhà sửa</div>
                </div>
                <div class="tracker-step @(step >= 3 ? "active completed" : "")">
                    <div class="tracker-circle">@(step == 3 ? "✓" : "3")</div>
                    <div class="tracker-label">3. Hoàn thành & Bảo hành</div>
                    <div class="tracker-sub">Nghiệm thu & kích hoạt bảo hành</div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning my-3">
                <i class="bi bi-info-circle me-2"></i>Phiếu này đã ngưng xử lý (@statusText).
            </div>
        }
    </div>

    <div class="row g-4">
        <!-- Main details -->
        <div class="col-lg-7">
            <!-- Device info -->
            <div class="detail-card">
                <h5 style="font-weight:700;margin-bottom:1rem;font-size:1.1rem"><i class="bi bi-tools me-2" style="color:var(--neon)"></i>Thông Tin Sự Cố</h5>
                <table class="table table-borderless mb-0" style="font-size:.9rem">
                    <tr><td class="text-muted" style="width:140px">Loại thiết bị:</td><td class="fw-bold">@Model.DeviceType</td></tr>
                    <tr><td class="text-muted">Thương hiệu:</td><td>@Model.Brand @(string.IsNullOrEmpty(Model.Model) ? "" : $"({Model.Model})")</td></tr>
                    <tr><td class="text-muted">Triệu chứng lỗi:</td><td class="fw-semibold" style="color:#D97706">@Model.Symptoms</td></tr>
                    @if (!string.IsNullOrEmpty(Model.DiagnosisNote))
                    {
                        <tr><td class="text-muted">Chẩn đoán KTV:</td><td><div style="background:var(--charcoal);padding:.75rem;border-radius:8px">@Model.DiagnosisNote</div></td></tr>
                    }
                </table>
            </div>

            <!-- Technician info -->
            @if (!string.IsNullOrEmpty(Model.TechnicianName) || Model.ScheduledAt.HasValue)
            {
                <div class="detail-card">
                    <h5 style="font-weight:700;margin-bottom:1rem;font-size:1.1rem"><i class="bi bi-person-badge me-2" style="color:var(--neon)"></i>Kỹ Thuật Viên Phụ Trách</h5>
                    <div class="d-flex align-items-center gap-3">
                        <div style="width:48px;height:48px;border-radius:50%;background:var(--charcoal);border:1px solid var(--grey-dark);display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:var(--neon)">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <div class="fw-bold">@(Model.TechnicianName ?? "Đang phân công...")</div>
                            @if (Model.ScheduledAt.HasValue)
                            {
                                <div style="font-size:.85rem;color:var(--grey)">
                                    <i class="bi bi-calendar-event me-1"></i>Hẹn đến sửa: <strong>@Model.ScheduledAt.Value.ToString("HH:mm - dd/MM/yyyy")</strong>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-5">
            <!-- Cost & Payment -->
            <div class="detail-card">
                <h5 style="font-weight:700;margin-bottom:1rem;font-size:1.1rem"><i class="bi bi-cash-coin me-2" style="color:var(--neon)"></i>Chi Phí Sửa Chữa</h5>
                @if (Model.ActualCost.HasValue)
                {
                    <div style="font-size:.8rem;color:var(--grey-mid)">Chi phí thực tế:</div>
                    <div style="font-size:1.5rem;font-weight:800;color:var(--neon)">@Model.ActualCost.Value.ToString("N0")đ</div>
                }
                else if (Model.EstimatedCost.HasValue)
                {
                    <div style="font-size:.8rem;color:var(--grey-mid)">Chi phí ước tính:</div>
                    <div style="font-size:1.5rem;font-weight:800;color:#F59E0B">@Model.EstimatedCost.Value.ToString("N0")đ</div>
                    <div style="font-size:.75rem;color:var(--grey);margin-top:4px">*Giá thực tế sẽ được KTV thống nhất sau khi kiểm tra.</div>
                }
                else
                {
                    <div style="color:var(--grey);font-size:.9rem">Chưa có báo giá. Cửa hàng sẽ gọi điện báo giá sớm nhất.</div>
                }
            </div>

            <!-- Store Contact -->
            <div class="detail-card">
                <h5 style="font-weight:700;margin-bottom:1rem;font-size:1.1rem"><i class="bi bi-shop me-2" style="color:var(--neon)"></i>Cửa Hàng Xử Lý</h5>
                <div class="fw-bold">@Model.StoreName</div>
                <div style="font-size:.85rem;color:var(--grey);margin-top:4px">Địa chỉ dịch vụ: @Model.CustomerAddress</div>
            </div>
        </div>
    </div>
</div>
