<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – CoolConnect</title>
    <meta name="theme-color" content="#FFFFFF" />

    <!-- SEO -->
    @RenderSection("Head", required: false)

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Layout base – prevent FOUC */
        body { background: #ffffff; color: #111111; }
        main { padding-top: 72px; }
        .hero { padding-top: 0 !important; }
    </style>
</head>
<body>

<!-- =========================================================
     SEARCH OVERLAY
     ========================================================= -->
<div class="search-overlay" id="searchOverlay" role="dialog" aria-label="Tìm kiếm">
    <button class="search-close" onclick="closeSearch()" id="search-close-btn" aria-label="Đóng tìm kiếm">
        <i class="bi bi-x-lg"></i>
    </button>
    <div class="search-box">
        <div class="search-input-wrap">
            <i class="bi bi-search"></i>
            <input type="search" id="globalSearchInput" placeholder="Tìm sản phẩm, cửa hàng..." autocomplete="off" />
        </div>
        <div id="searchSuggestions" style="margin-top:2rem">
            <div class="label-mono" style="margin-bottom:1rem;color:var(--grey-mid)">Tìm kiếm phổ biến</div>
            <div style="display:flex;gap:.75rem;flex-wrap:wrap">
                @foreach (var tag in new[]{"Điều hòa Daikin","Máy giặt LG","Sửa điều hòa","Bình nóng lạnh","Tủ lạnh Samsung"})
                {
                    <button onclick="document.getElementById('globalSearchInput').value='@tag'" 
                            style="background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:var(--grey);padding:8px 16px;border-radius:100px;font-size:.8rem;cursor:pointer;transition:all .2s"
                            onmouseover="this.style.borderColor='var(--neon)';this.style.color='var(--neon)'"
                            onmouseout="this.style.borderColor='rgba(255,255,255,.1)';this.style.color='var(--grey)'">
                        @tag
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- =========================================================
     NAVBAR
     ========================================================= -->
<nav class="navbar" id="mainNavbar" role="navigation">
    <div class="container navbar-inner">
        <!-- Logo -->
        <a href="/" class="nav-logo" id="nav-logo">
            <div class="nav-logo-icon">CC</div>
            <span>Cool<span style="color:var(--neon);font-weight:800">Connect</span></span>
        </a>

        <!-- Links -->
        <ul class="nav-links" role="list">
            <li><a href="/stores" id="nav-stores" class="@(Context.Request.Path.StartsWithSegments("/stores") ? "active" : "")">Cửa hàng</a></li>
            <li><a href="/products" id="nav-products" class="@(Context.Request.Path.StartsWithSegments("/products") ? "active" : "")">Sản phẩm</a></li>
            <li><a href="/repairs/book" id="nav-repairs" class="@(Context.Request.Path.StartsWithSegments("/repairs") ? "active" : "")">Đặt lịch sửa chữa</a></li>
            <li><a href="/chat" id="nav-ai">AI Tư vấn</a></li>
            <li><a href="#why-us" id="nav-about">Về chúng tôi</a></li>
        </ul>

        <!-- Actions -->
        <div class="nav-actions">
            <button class="nav-search-btn" onclick="openSearch()" id="nav-search-btn" aria-label="Mở tìm kiếm">
                <i class="bi bi-search"></i>
            </button>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- User Dropdown -->
                <div style="position:relative" id="nav-user-wrap">
                    <button onclick="toggleUserMenu()" id="nav-user-btn"
                            style="display:flex;align-items:center;gap:8px;background:var(--charcoal);border:1px solid var(--grey-dark);padding:6px 12px 6px 8px;border-radius:100px;cursor:pointer;font-family:var(--font-main);font-size:.8rem;color:var(--black);transition:all .2s">
                        <div style="width:28px;height:28px;background:var(--neon);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:.75rem;flex-shrink:0">
                            @(User.Identity.Name?.Substring(0,1).ToUpper() ?? "U")
                        </div>
                        <span style="max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@User.Identity.Name</span>
                        <i class="bi bi-chevron-down" style="font-size:.65rem;color:var(--grey-mid)"></i>
                    </button>
                    <div id="user-dropdown" style="display:none;position:absolute;right:0;top:calc(100% + 8px);background:var(--white);border:1px solid var(--grey-dark);border-radius:var(--radius-md);box-shadow:0 10px 30px rgba(0,0,0,.1);min-width:200px;z-index:2000;padding:6px">
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <a href="/admin" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:6px;font-size:.85rem;color:var(--neon);font-weight:600;text-decoration:none" onmouseover="this.style.background='var(--charcoal)'" onmouseout="this.style.background='transparent'">
                                <i class="bi bi-grid-1x2"></i> Admin Dashboard
                            </a>
                        }
                        @if (User.IsInRole("StoreOwner") || User.IsInRole("StoreStaff"))
                        {
                            <a href="/manage/dashboard" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:6px;font-size:.85rem;color:var(--neon);font-weight:600;text-decoration:none" onmouseover="this.style.background='var(--charcoal)'" onmouseout="this.style.background='transparent'">
                                <i class="bi bi-speedometer2"></i> Quản lý cửa hàng
                            </a>
                        }
                        <a href="/manage/profile" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:6px;font-size:.85rem;color:var(--black);text-decoration:none" onmouseover="this.style.background='var(--charcoal)'" onmouseout="this.style.background='transparent'">
                            <i class="bi bi-person-circle"></i> Tài khoản
                        </a>
                        <a href="/auth/orders" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:6px;font-size:.85rem;color:var(--black);text-decoration:none" onmouseover="this.style.background='var(--charcoal)'" onmouseout="this.style.background='transparent'">
                            <i class="bi bi-bag-heart"></i> Đơn hàng của tôi
                        </a>
                        <a href="/auth/repairs" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:6px;font-size:.85rem;color:var(--black);text-decoration:none" onmouseover="this.style.background='var(--charcoal)'" onmouseout="this.style.background='transparent'">
                            <i class="bi bi-tools"></i> Sửa chữa của tôi
                        </a>
                        <div style="border-top:1px solid var(--grey-dark);margin:4px 0"></div>
                        <form method="post" action="/auth/logout" style="margin:0">
                            @Html.AntiForgeryToken()
                            <button type="submit" style="display:flex;align-items:center;gap:8px;padding:9px 14px;border-radius:6px;font-size:.85rem;color:#E11D48;background:none;border:none;cursor:pointer;width:100%;text-align:left" onmouseover="this.style.background='#FEF2F2'" onmouseout="this.style.background='transparent'">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a href="/auth/login" class="btn btn-outline" style="padding:8px 18px;font-size:.8rem" id="nav-login-btn">
                    Đăng nhập
                </a>
                <a href="/auth/register" class="btn btn-neon" style="padding:8px 18px;font-size:.8rem" id="nav-register-btn">
                    Đăng ký
                </a>
            }

            <button class="nav-hamburger" onclick="toggleMobileMenu()" id="nav-hamburger" aria-label="Menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</nav>

<div class="mobile-menu" id="mobileMenu" role="navigation">
    <ul class="mobile-links">
        <li><a href="/stores" onclick="closeMobileMenu()"><i class="bi bi-shop me-2"></i>Cửa hàng</a></li>
        <li><a href="/products" onclick="closeMobileMenu()"><i class="bi bi-grid me-2"></i>Sản phẩm</a></li>
        <li><a href="/chat" onclick="closeMobileMenu()"><i class="bi bi-robot me-2"></i>AI Tư vấn</a></li>
        @if (User.Identity?.IsAuthenticated == true)
        {
            @if (User.IsInRole("SuperAdmin"))
            {
                <li><a href="/admin" onclick="closeMobileMenu()" style="color:var(--neon)"><i class="bi bi-grid-1x2 me-2"></i>Admin</a></li>
            }
            @if (User.IsInRole("StoreOwner") || User.IsInRole("StoreStaff"))
            {
                <li><a href="/manage/dashboard" onclick="closeMobileMenu()" style="color:var(--neon)"><i class="bi bi-speedometer2 me-2"></i>Quản lý cửa hàng</a></li>
            }
            <li><a href="/manage/profile" onclick="closeMobileMenu()"><i class="bi bi-person-circle me-2"></i>Tài khoản</a></li>
            <li><a href="/auth/orders" onclick="closeMobileMenu()"><i class="bi bi-bag-heart me-2"></i>Đơn hàng của tôi</a></li>
            <li>
                <form method="post" action="/auth/logout" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="background:none;border:none;padding:0;font-family:var(--font-main);font-size:1rem;color:#E11D48;cursor:pointer;display:flex;align-items:center;gap:8px">
                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                    </button>
                </form>
            </li>
        }
        else
        {
            <li><a href="/auth/login" onclick="closeMobileMenu()"><i class="bi bi-person me-2"></i>Đăng nhập</a></li>
            <li><a href="/auth/register" onclick="closeMobileMenu()" style="color:var(--neon)"><i class="bi bi-person-plus me-2"></i>Đăng ký</a></li>
        }
    </ul>
</div>

<!-- =========================================================
     MAIN CONTENT
     ========================================================= -->
<main role="main">
    @RenderBody()
</main>

<!-- =========================================================
     FOOTER
     ========================================================= -->
<footer class="footer" role="contentinfo">
    <div class="container">
        <div class="footer-grid">
            <!-- Brand -->
            <div>
                <a href="/" class="nav-logo" style="margin-bottom:1rem;display:inline-flex">
                    <div class="nav-logo-icon">CC</div>
                    <span>Cool<span style="color:var(--neon);font-weight:800">Connect</span></span>
                </a>
                <p class="footer-brand-desc">
                    Nền tảng Marketplace kết nối người dùng với hàng trăm cửa hàng điện lạnh uy tín. Tư vấn AI, lắp đặt tại nhà, bảo hành toàn quốc.
                </p>
                <div class="footer-social">
                    <a href="#" class="social-btn" id="footer-fb" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-btn" id="footer-yt" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    <a href="#" class="social-btn" id="footer-zalo" aria-label="Zalo"><i class="bi bi-chat-dots"></i></a>
                    <a href="#" class="social-btn" id="footer-tiktok" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>

            <!-- Dịch vụ -->
            <div>
                <div class="footer-col-title">Dịch vụ</div>
                <ul class="footer-links">
                    <li><a href="/stores">Tìm cửa hàng</a></li>
                    <li><a href="#">Lắp đặt điều hòa</a></li>
                    <li><a href="#">Sửa chữa điện lạnh</a></li>
                    <li><a href="#">Bảo dưỡng định kỳ</a></li>
                    <li><a href="/chat">AI Tư vấn</a></li>
                </ul>
            </div>

            <!-- Sản phẩm -->
            <div>
                <div class="footer-col-title">Sản phẩm</div>
                <ul class="footer-links">
                    <li><a href="#">Điều hòa Inverter</a></li>
                    <li><a href="#">Máy giặt lồng ngang</a></li>
                    <li><a href="#">Tủ lạnh</a></li>
                    <li><a href="#">Bình nóng lạnh</a></li>
                    <li><a href="#">Máy lọc nước</a></li>
                </ul>
            </div>

            <!-- Hỗ trợ -->
            <div>
                <div class="footer-col-title">Hỗ trợ</div>
                <ul class="footer-links">
                    <li><a href="#">Trung tâm hỗ trợ</a></li>
                    <li><a href="#">Đăng ký cửa hàng</a></li>
                    <li><a href="#">Chính sách bảo hành</a></li>
                    <li><a href="#">Điều khoản dịch vụ</a></li>
                </ul>
                <div style="margin-top:1.5rem">
                    <div class="label-mono" style="margin-bottom:.5rem;color:var(--grey-mid)">Hotline</div>
                    <a href="tel:1800xxxx" style="font-size:1.25rem;font-weight:700;color:var(--neon)">1800 xxxx</a>
                    <div style="font-size:.7rem;color:var(--grey-mid);margin-top:.25rem;font-family:var(--font-mono)">8:00 – 22:00 mỗi ngày</div>
                </div>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;width:100%">
            <p class="footer-bottom-text">© 2025 COOLCONNECT. ALL RIGHTS RESERVED.</p>
            <div class="footer-bottom-links">
                <a href="#">PRIVACY</a>
                <a href="#">TERMS</a>
                <a href="#">SITEMAP</a>
            </div>
        </div>
    </div>
</footer>

<!-- =========================================================
     SCRIPTS
     ========================================================= -->
<script>
// ----- Navbar scroll effect -----
const navbar = document.getElementById('mainNavbar');
window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 40);
}, { passive: true });

// ----- Search overlay -----
function openSearch() {
    document.getElementById('searchOverlay').classList.add('open');
    setTimeout(() => document.getElementById('globalSearchInput').focus(), 100);
}
function closeSearch() {
    document.getElementById('searchOverlay').classList.remove('open');
}
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeSearch();
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
});

function toggleMobileMenu() {
    document.getElementById('mobileMenu').classList.toggle('open');
}
function closeMobileMenu() {
    document.getElementById('mobileMenu').classList.remove('open');
}

// ----- User dropdown -----
function toggleUserMenu() {
    const dd = document.getElementById('user-dropdown');
    if (dd) dd.style.display = dd.style.display === 'none' ? 'block' : 'none';
}
document.addEventListener('click', (e) => {
    const wrap = document.getElementById('nav-user-wrap');
    const dd = document.getElementById('user-dropdown');
    if (wrap && dd && !wrap.contains(e.target)) dd.style.display = 'none';
});

// ----- Scroll animations -----
const animEls = document.querySelectorAll('[data-animate]');
const io = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
            entry.target.style.transitionDelay = `${i * 80}ms`;
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
        }
    });
}, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
animEls.forEach(el => io.observe(el));

// ----- Counter animations -----
function animateCounter(el, target, suffix = '') {
    let start = 0;
    const duration = 1800;
    const step = (timestamp) => {
        if (!start) start = timestamp;
        const progress = Math.min((timestamp - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(eased * target).toLocaleString('vi-VN') + suffix;
        if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
}

// Trigger counters when stats come into view
const statsSection = document.querySelector('.hero-stats');
if (statsSection) {
    const statsIO = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
            animateCounter(document.getElementById('stat-stores'), 200, '+');
            animateCounter(document.getElementById('stat-products'), 5000, '+');
            animateCounter(document.getElementById('stat-orders'), 12000, '+');
            statsIO.disconnect();
        }
    }, { threshold: 0.5 });
    statsIO.observe(statsSection);
}

// ----- Smooth hash navigation -----
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
});
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
