@model IEnumerable<DiemLanh.Application.DTOs.Store.StoreServiceAreaDto>
@{
    ViewData["Title"] = "Khu vực phục vụ";
    ViewData["ActivePage"] = "ServiceAreas";
    Layout = "_StoreLayout";
    var storeId = ViewBag.StoreId as int? ?? 0;
}

@if (TempData["Success"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]</div> }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Khu vực phục vụ</h4>
        <p class="text-muted mb-0">Quản lý phạm vi hoạt động của cửa hàng</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Areas list -->
        <div class="card">
            <div class="card-header fw-bold"><i class="bi bi-geo-alt me-2"></i>Danh sách khu vực (@Model.Count()) khu vực</div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:var(--bg)">
                        <tr>
                            <th class="ps-4">Tỉnh / Thành</th>
                            <th>Quận / Huyện</th>
                            <th>Phường / Xã</th>
                            <th>Bán kính (km)</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var area in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@area.Province</td>
                                <td>@(area.District ?? "—")</td>
                                <td>@(area.Ward ?? "—")</td>
                                <td>@(area.RadiusKm.HasValue ? $"{area.RadiusKm:0}km" : "—")</td>
                                <td>
                                    @if (area.IsActive)
                                    {
                                        <span class="badge" style="background:#D1FAE5;color:#065F46">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#F3F4F6;color:#374151">Tạm ngưng</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" onclick="removeArea(@area.Id)" title="Xóa khu vực">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center py-4 text-muted"><i class="bi bi-geo-alt fs-2 d-block mb-2"></i>Chưa có khu vực phục vụ nào. Hãy thêm khu vực bên phải.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Add area form -->
        <div class="card">
            <div class="card-header fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm khu vực mới</div>
            <div class="card-body">
                <form method="post" action="/manage/addservicearea">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                        <select name="Province" class="form-select form-select-sm" required>
                            <option value="">-- Chọn tỉnh/thành --</option>
                            @foreach (var p in new[] { "Hà Nội","TP. Hồ Chí Minh","Đà Nẵng","Hải Phòng","Cần Thơ","An Giang","Bà Rịa - Vũng Tàu","Bắc Giang","Bắc Kạn","Bạc Liêu","Bắc Ninh","Bến Tre","Bình Định","Bình Dương","Bình Phước","Bình Thuận","Cà Mau","Cao Bằng","Đắk Lắk","Đắk Nông","Điện Biên","Đồng Nai","Đồng Tháp","Gia Lai","Hà Giang","Hà Nam","Hà Tĩnh","Hải Dương","Hậu Giang","Hòa Bình","Hưng Yên","Khánh Hòa","Kiên Giang","Kon Tum","Lai Châu","Lâm Đồng","Lạng Sơn","Lào Cai","Long An","Nam Định","Nghệ An","Ninh Bình","Ninh Thuận","Phú Thọ","Phú Yên","Quảng Bình","Quảng Nam","Quảng Ngãi","Quảng Ninh","Quảng Trị","Sóc Trăng","Sơn La","Tây Ninh","Thái Bình","Thái Nguyên","Thanh Hóa","Thừa Thiên Huế","Tiền Giang","Trà Vinh","Tuyên Quang","Vĩnh Long","Vĩnh Phúc","Yên Bái" })
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Quận / Huyện (tuỳ chọn)</label>
                        <input type="text" name="District" class="form-control form-control-sm" placeholder="Ví dụ: Quận 1, Huyện Củ Chi..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Phường / Xã (tuỳ chọn)</label>
                        <input type="text" name="Ward" class="form-control form-control-sm" placeholder="Ví dụ: Phường Bến Nghé..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Bán kính phục vụ (km)</label>
                        <input type="number" name="RadiusKm" class="form-control form-control-sm" placeholder="Ví dụ: 20" min="1" max="200" step="1" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-plus me-1"></i>Thêm khu vực
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
async function removeArea(id) {
    if (!confirm('Xóa khu vực này?')) return;
    const resp = await fetch(`/manage/removeservicearea/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value } });
    const data = await resp.json();
    if (data.success) location.reload();
    else alert('Có lỗi xảy ra.');
}
</script>
