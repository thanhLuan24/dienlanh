@model DiemLanh.Application.DTOs.Store.StoreDto
@{
    ViewData["Title"] = "Thông tin Cửa hàng";
    ViewData["ActivePage"] = "Profile";
    Layout = "_StoreLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold">Thông tin Cửa hàng</h4>
    <a href="/stores/@Model.Slug" target="_blank" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-box-arrow-up-right me-1"></i>Xem trang cửa hàng
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
    </div>
}

<div class="row g-4">
    <!-- Logo & Cover -->
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header fw-semibold"><i class="bi bi-image me-2"></i>Hình ảnh</div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <label class="form-label fw-semibold d-block">Logo cửa hàng</label>
                    <div class="d-flex justify-content-center mb-2">
                        @if (!string.IsNullOrEmpty(Model.LogoUrl))
                        {
                            <img id="logoPreview" src="@Model.LogoUrl" alt="Logo" style="width:100px;height:100px;object-fit:cover;border-radius:12px;border:2px solid #e2e8f0;" />
                        }
                        else
                        {
                            <div id="logoPreview" style="width:100px;height:100px;background:linear-gradient(135deg,#3b82f6,#06b6d4);border-radius:12px;display:flex;align-items:center;justify-content:center;color:white;font-size:2rem;font-weight:700;">
                                @(string.IsNullOrEmpty(Model.Name) ? "S" : Model.Name.Substring(0, 1))
                            </div>
                        }
                    </div>
                    <input type="file" id="logoInput" accept="image/*" class="d-none" onchange="uploadImage(this,'logo')" />
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('logoInput').click()">
                        <i class="bi bi-upload me-1"></i>Đổi logo
                    </button>
                </div>
                <hr />
                <div>
                    <label class="form-label fw-semibold d-block">Ảnh bìa</label>
                    <div class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                        {
                            <img id="coverPreview" src="@Model.CoverImageUrl" alt="Cover" style="width:100%;height:80px;object-fit:cover;border-radius:8px;" />
                        }
                        else
                        {
                            <div id="coverPreview" style="width:100%;height:80px;background:linear-gradient(135deg,#0f172a,#1e3a5f);border-radius:8px;"></div>
                        }
                    </div>
                    <input type="file" id="coverInput" accept="image/*" class="d-none" onchange="uploadImage(this,'cover')" />
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="document.getElementById('coverInput').click()">
                        <i class="bi bi-upload me-1"></i>Đổi ảnh bìa
                    </button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-bar-chart me-2"></i>Thống kê nhanh</div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Đánh giá</span>
                    <span class="fw-semibold">⭐ @Model.AverageRating?.ToString("F1") / 5</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Số đánh giá</span>
                    <span class="fw-semibold">@Model.TotalReviews</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Ngày tham gia</span>
                    <span class="fw-semibold">@Model.JoinedAt.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Form -->
    <div class="col-lg-8">
        <form method="post" action="/manage/profile">
            @Html.AntiForgeryToken()
            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-shop me-2"></i>Thông tin cơ bản</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên cửa hàng <span class="text-danger">*</span></label>
                        <input type="text" name="Name" value="@Model.Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả cửa hàng</label>
                        <textarea name="Description" rows="4" class="form-control">@Model.Description</textarea>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="tel" name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giờ mở cửa</label>
                            <input type="time" name="OpenTime" value="@Model.OpenTime.ToString("HH:mm")" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giờ đóng cửa</label>
                            <input type="time" name="CloseTime" value="@Model.CloseTime.ToString("HH:mm")" class="form-control" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label fw-semibold">Link Google Maps</label>
                        <input type="url" name="GoogleMapsUrl" value="@Model.GoogleMapsUrl" class="form-control" placeholder="https://maps.google.com/..." />
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-geo-alt me-2"></i>Địa chỉ cửa hàng</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Địa chỉ nhà / Đường</label>
                        <input type="text" name="Street" value="@Model.Address?.Street" class="form-control" placeholder="Ví dụ: 123 Nguyễn Văn Cừ" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Phường / Xã</label>
                            <input type="text" name="Ward" value="@Model.Address?.Ward" class="form-control" placeholder="Phường 4" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Quận / Huyện</label>
                            <input type="text" name="District" value="@Model.Address?.District" class="form-control" placeholder="Quận 5" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Tỉnh / Thành phố</label>
                            <input type="text" name="Province" value="@Model.Address?.Province" class="form-control" placeholder="TP. Hồ Chí Minh" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold"><i class="bi bi-file-text me-2"></i>Chính sách</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Chính sách bảo hành</label>
                        <textarea name="WarrantyPolicy" rows="3" class="form-control">@Model.WarrantyPolicy</textarea>
                    </div>
                    <div>
                        <label class="form-label fw-semibold">Chính sách đổi trả</label>
                        <textarea name="ReturnPolicy" rows="3" class="form-control">@Model.ReturnPolicy</textarea>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-2"></i>Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function uploadImage(input, type) {
    if (!input.files[0]) return;
    const formData = new FormData();
    formData.append('file', input.files[0]);

    fetch(`/manage/upload-${type}`, {
        method: 'POST',
        body: formData,
        headers: { 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value ?? '' }
    })
    .then(r => r.json())
    .then(d => {
        if (d.success) {
            const el = document.getElementById(type + 'Preview');
            if (el.tagName === 'IMG') {
                el.src = d.url;
            } else {
                const img = document.createElement('img');
                img.id = type + 'Preview';
                img.src = d.url;
                img.style.cssText = el.style.cssText + 'object-fit:cover;';
                el.replaceWith(img);
            }
            alert('Đã cập nhật ' + (type === 'logo' ? 'logo' : 'ảnh bìa') + ' thành công!');
        } else {
            alert('Lỗi khi tải ảnh lên.');
        }
    });
}
</script>
}
