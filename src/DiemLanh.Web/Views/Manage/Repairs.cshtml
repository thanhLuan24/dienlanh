@model DiemLanh.Application.Common.PagedResult<DiemLanh.Application.DTOs.Repair.RepairRequestDto>
@using DiemLanh.Domain.Enums
@{
    ViewData["Title"] = "Yêu cầu sửa chữa";
    ViewData["ActivePage"] = "Repairs";
    Layout = "_StoreLayout";
    var filter = ViewBag.Filter as DiemLanh.Application.DTOs.Repair.RepairFilterDto ?? new();
    var techs = ViewBag.Technicians as IEnumerable<DiemLanh.Application.Interfaces.TechnicianDto> ?? Enumerable.Empty<DiemLanh.Application.Interfaces.TechnicianDto>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Yêu cầu sửa chữa</h4>
        <p class="text-muted mb-0">Tổng @Model.TotalCount yêu cầu</p>
    </div>
</div>

<!-- Quick filter tabs -->
<div style="display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.25rem">
    @{
        var repairTabs = new (RepairStatus? s, string lbl)[] {
            (null, "Tất cả"), (RepairStatus.PendingReceive, "Chờ tiếp nhận"),
            (RepairStatus.Checking, "Đang kiểm tra"), (RepairStatus.Scheduled, "Đã hẹn lịch"),
            (RepairStatus.Repairing, "Đang sửa"), (RepairStatus.Completed, "Hoàn thành"),
            (RepairStatus.CannotRepair, "Không thể sửa")
        };
        foreach (var (st, lbl) in repairTabs)
        {
            var active = filter.Status == st;
            var href = st == null ? "/manage/repairs" : $"/manage/repairs?Status={(int)st}";
            <a href="@href" style="padding:5px 14px;border-radius:100px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;text-decoration:none;border:1.5px solid @(active?"var(--primary)":"var(--border)");background:@(active?"var(--primary)":"var(--surface)");color:@(active?"#fff":"var(--text-muted)")">@lbl</a>
        }
    }
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/manage/repairs">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <input type="text" name="Keyword" value="@filter.Keyword" class="form-control form-control-sm" placeholder="Tên, SĐT, thiết bị..." />
                </div>
                <div class="col-md-3">
                    <input type="text" name="DeviceType" value="@filter.DeviceType" class="form-control form-control-sm" placeholder="Loại thiết bị..." />
                </div>
                <div class="col-md-3">
                    @{
                        var techFilterHtml2 = "<select name='TechnicianId' class='form-select form-select-sm'><option value=''>-- Tất cả KTV --</option>";
                        foreach (var t in techs)
                            techFilterHtml2 += $"<option value='{t.Id}'{(filter.TechnicianId == t.Id ? " selected" : "")}>{t.Name}</option>";
                        techFilterHtml2 += "</select>";
                    }
                    @Html.Raw(techFilterHtml2)
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search me-1"></i>Lọc</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background:var(--bg)">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Khách hàng</th>
                        <th>Thiết bị</th>
                        <th>Thương hiệu</th>
                        <th>KTV</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        var (bg, fg) = r.Status switch {
                            RepairStatus.PendingReceive => ("#FEF9C3","#854D0E"),
                            RepairStatus.Checking => ("#DBEAFE","#1E40AF"),
                            RepairStatus.Scheduled => ("#EDE9FE","#5B21B6"),
                            RepairStatus.Repairing => ("#FED7AA","#9A3412"),
                            RepairStatus.Completed => ("#D1FAE5","#065F46"),
                            RepairStatus.CannotRepair => ("#FEE2E2","#991B1B"),
                            _ => ("#F3F4F6","#374151")
                        };
                        <tr>
                            <td class="ps-4"><code>#@r.Id</code></td>
                            <td>
                                <div class="fw-semibold">@r.CustomerName</div>
                                <small class="text-muted">@r.CustomerPhone</small>
                            </td>
                            <td>@r.DeviceType</td>
                            <td>@r.Brand</td>
                            <td>@(r.TechnicianName ?? "—")</td>
                            <td><span style="background:@bg;color:@fg;padding:3px 10px;border-radius:100px;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em">@r.StatusDisplay</span></td>
                            <td style="font-size:.8rem;color:var(--text-muted)">@r.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td><a href="/manage/repair-detail/@r.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-tools fs-1 d-block mb-2"></i>Chưa có yêu cầu sửa chữa nào</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="/manage/repairs?Page=@p&Status=@filter.Status">@p</a>
                </li>
            }
        </ul>
    </nav>
}
