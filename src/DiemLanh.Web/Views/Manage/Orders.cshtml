@model DiemLanh.Application.Common.PagedResult<DiemLanh.Application.DTOs.Order.OrderListDto>
@using DiemLanh.Domain.Enums
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    ViewData["ActivePage"] = "Orders";
    Layout = "_StoreLayout";
    var filter = ViewBag.Filter as DiemLanh.Application.DTOs.Order.OrderFilterDto ?? new();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3"><i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Quản lý Đơn hàng</h4>
        <p class="text-muted mb-0">Tổng cộng @Model.TotalCount đơn hàng</p>
    </div>
</div>

<!-- Quick status tabs -->
<div style="display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1.25rem">
    @{
        var tabs = new[] {
            (null as OrderStatus?, "Tất cả", Model.TotalCount),
            (OrderStatus.PendingConfirmation as OrderStatus?, "Chờ xác nhận", 0),
            (OrderStatus.Confirmed as OrderStatus?, "Đã xác nhận", 0),
            (OrderStatus.Preparing as OrderStatus?, "Đang chuẩn bị", 0),
            (OrderStatus.Shipping as OrderStatus?, "Đang giao", 0),
            (OrderStatus.Delivered as OrderStatus?, "Đã giao", 0),
            (OrderStatus.Completed as OrderStatus?, "Hoàn thành", 0),
            (OrderStatus.Cancelled as OrderStatus?, "Đã hủy", 0),
        };
        foreach (var (st, label, cnt) in tabs)
        {
            var active = filter.Status == st;
            var href = st == null ? "/manage/orders" : $"/manage/orders?Status={(int)st}";
            <a href="@href" style="padding:5px 14px;border-radius:100px;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;text-decoration:none;border:1.5px solid @(active?"var(--primary)":"var(--border)");background:@(active?"var(--primary)":"var(--surface)");color:@(active?"#fff":"var(--text-muted)")">@label</a>
        }
    }
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/manage/orders">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <input type="text" name="Keyword" value="@filter.Keyword" class="form-control form-control-sm" placeholder="Mã đơn, tên khách, SĐT..." />
                </div>
                <div class="col-md-3">
                    <input type="date" name="FromDate" value="@filter.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <input type="date" name="ToDate" value="@filter.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background:var(--bg)">
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>SĐT</th>
                        <th>Sản phẩm</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày đặt</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Items)
                    {
                        var (bg, tc) = o.Status switch {
                            OrderStatus.PendingConfirmation => ("#FEF9C3","#854D0E"),
                            OrderStatus.Confirmed => ("#DBEAFE","#1E40AF"),
                            OrderStatus.Preparing => ("#EDE9FE","#5B21B6"),
                            OrderStatus.Shipping => ("#CFFAFE","#0E7490"),
                            OrderStatus.Delivered or OrderStatus.Installed => ("#D1FAE5","#065F46"),
                            OrderStatus.Completed => ("#D1FAE5","#065F46"),
                            OrderStatus.Cancelled or OrderStatus.Rejected => ("#FEE2E2","#991B1B"),
                            _ => ("#F3F4F6","#374151")
                        };
                        <tr>
                            <td class="ps-4"><span style="font-family:monospace;font-weight:700;color:var(--primary)">#@o.OrderCode</span></td>
                            <td>@o.CustomerName</td>
                            <td>@o.CustomerPhone</td>
                            <td><span style="font-size:.8rem">@o.ItemCount sản phẩm</span></td>
                            <td><strong>@o.TotalAmount.ToString("N0")đ</strong></td>
                            <td><span style="background:@bg;color:@tc;padding:3px 10px;border-radius:100px;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em">@o.StatusDisplay</span></td>
                            <td style="font-size:.8rem;color:var(--text-muted)">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><a href="/manage/order-detail/@o.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-bag-x fs-1 d-block mb-2"></i>Chưa có đơn hàng nào</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" href="/manage/orders?Page=@p&Status=@filter.Status&Keyword=@filter.Keyword">@p</a>
                </li>
            }
        </ul>
    </nav>
}
